# Permissions du projet ; voir docs/permissions-ia.md.
# Aucun shell ou interpreteur autorise globalement.
prefix_rule(pattern = ["git",["status","diff","log","show","ls-files","rev-parse","check-ignore","ls-tree","add","fetch","switch"]], decision = "allow")
prefix_rule(pattern = ["codegraph",["query","node","impact","status"]], decision = "allow")
prefix_rule(pattern = [["gradlew","gradlew.bat","./gradlew",".\\gradlew",".\\gradlew.bat"],["build","test","classes","compileJava","processResources","runClient","runServer","runData","runGameTestServer","tasks","help","--version"]], decision = "allow")
prefix_rule(pattern = ["Get-Content"], decision = "allow")
prefix_rule(pattern = ["Get-ChildItem"], decision = "allow")
prefix_rule(pattern = ["Get-Item"], decision = "allow")
prefix_rule(pattern = ["Test-Path"], decision = "allow")
prefix_rule(pattern = ["Resolve-Path"], decision = "allow")
prefix_rule(pattern = ["Get-Location"], decision = "allow")
prefix_rule(pattern = ["Get-Command"], decision = "allow")
prefix_rule(pattern = ["Get-FileHash"], decision = "allow")
prefix_rule(pattern = ["java","-version"], decision = "allow")
prefix_rule(pattern = ["git","commit"], decision = "prompt")
prefix_rule(pattern = ["git","push"], decision = "prompt")
prefix_rule(pattern = ["git","reset"], decision = "prompt")
prefix_rule(pattern = ["git","clean"], decision = "prompt")
prefix_rule(pattern = ["git","restore"], decision = "prompt")
prefix_rule(pattern = ["git","checkout"], decision = "prompt")
prefix_rule(pattern = ["git","rebase"], decision = "prompt")
prefix_rule(pattern = ["git","branch"], decision = "prompt")
prefix_rule(pattern = ["git","tag"], decision = "prompt")
prefix_rule(pattern = ["git","stash"], decision = "prompt")
prefix_rule(pattern = ["git","config"], decision = "prompt")
prefix_rule(pattern = ["git","remote"], decision = "prompt")
prefix_rule(pattern = ["git","switch","--discard-changes"], decision = "prompt")
prefix_rule(pattern = ["git","switch","-f"], decision = "prompt")
prefix_rule(pattern = ["git","switch","-C"], decision = "prompt")
prefix_rule(pattern = ["gh","pr","merge"], decision = "prompt")
prefix_rule(pattern = ["gh","repo","delete"], decision = "prompt")
prefix_rule(pattern = ["gh","workflow","run"], decision = "prompt")
prefix_rule(pattern = ["rm"], decision = "prompt")
prefix_rule(pattern = ["rmdir"], decision = "prompt")
prefix_rule(pattern = ["del"], decision = "prompt")
prefix_rule(pattern = ["Remove-Item"], decision = "prompt")
prefix_rule(pattern = ["Clear-Content"], decision = "prompt")
prefix_rule(pattern = ["Move-Item"], decision = "prompt")
prefix_rule(pattern = ["Stop-Process"], decision = "prompt")
prefix_rule(pattern = ["Stop-Service"], decision = "prompt")
prefix_rule(pattern = ["Restart-Service"], decision = "prompt")
prefix_rule(pattern = ["shutdown"], decision = "prompt")
prefix_rule(pattern = ["format"], decision = "prompt")
prefix_rule(pattern = ["Format-Volume"], decision = "prompt")
prefix_rule(pattern = ["Clear-Disk"], decision = "prompt")
prefix_rule(pattern = ["diskpart"], decision = "prompt")
prefix_rule(pattern = ["git", "status"], decision = "allow", match = ["git status --short"], not_match = ["git push origin main"])
