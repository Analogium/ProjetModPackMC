{
  "mcpServers": {
    "codegraph": {
      "type": "stdio",
      "command": "node",
      "args": ["-e", "require('child_process').spawn('codegraph serve --mcp',{stdio:'inherit',shell:true}).on('exit',c=>process.exit(c??1))"]
    },
    "minestrator": {
      "type": "http",
      "url": "https://mcp.sttr.io/minestrator",
      "headers": {
        "Authorization": "Bearer ${MINESTRATOR_API_KEY}"
      }
    }
  }
}
